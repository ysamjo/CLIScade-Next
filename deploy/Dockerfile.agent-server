FROM node:24.19.0-bookworm-slim AS login-cli
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl unzip \
 && rm -rf /var/lib/apt/lists/* \
 && npm install -g @openai/codex@0.163.0 @anthropic-ai/claude-code@2.1.301 opencode-ai@1.18.23 @tencent-ai/codebuddy-code@2.168.0
RUN case "$(dpkg --print-architecture)" in \
 amd64) arch=x86_64; checksum=486067b0eee176bab0309d64ec40f5113ab65d687f0f2d581d8f820c8cd57a4b ;; \
 arm64) arch=aarch64; checksum=7e1b74ee1750784f910c23ed3a732efc2cafdc0a7787d49ecd1ad6f1d38fac5f ;; \
 *) exit 1 ;; esac \
 && curl -fsSL "https://prod.download.cli.kiro.dev/stable/2.31.1/kirocli-${arch}-linux-musl.tar.gz" -o /tmp/kiro.tar.gz \
 && echo "$checksum  /tmp/kiro.tar.gz" | sha256sum -c - \
 && mkdir /tmp/kiro && tar -xzf /tmp/kiro.tar.gz -C /tmp/kiro \
 && find /tmp/kiro -type f -name 'kiro-cli*' -exec cp '{}' /usr/local/bin/ \; \
 && test -x /usr/local/bin/kiro-cli \
 && rm -rf /tmp/kiro /tmp/kiro.tar.gz

RUN case "$(dpkg --print-architecture)" in \
 amd64) arch=x86_64; checksum=fbb2d54dd94fb897845308d3b6b46187c627f1c60078ded81adeeaf8b90c5d7a ;; \
 arm64) arch=arm64; checksum=3dc43a21f5402b23a4dba7b320a6745e9dbf4b6ead912ce9fc76011ea3a08a7e ;; \
 *) exit 1 ;; esac \
 && curl -fsSL "https://dl.google.com/agy-extensions/releases/linux/agy-acp-server-1.4.0-linux-${arch}.zip" -o /tmp/agy.zip \
 && echo "$checksum  /tmp/agy.zip" | sha256sum -c - \
 && unzip -q /tmp/agy.zip -d /tmp/agy \
 && install -m 755 /tmp/agy/agy_acp_server.par /tmp/agy/localharness_external /usr/local/bin/ \
 && rm -rf /tmp/agy /tmp/agy.zip

FROM ghcr.io/astral-sh/uv:0.12.23 AS uv
FROM ghcr.io/openhands/agent-server:1.55.1-python
USER root
COPY --from=uv /uv /usr/local/bin/uv
# Der Upstream-Entrypoint ist eingefroren. Der gepinnte SDK-Fork muss deshalb
# als Python-Paket laufen; pip im System-Python ändert den Upstream-Binary nicht.
RUN mkdir -p /opt/cliscade-sdk \
 && curl -fsSL https://codeload.github.com/ysamjo/CLIScade-Next-SDK/tar.gz/099e727faeb869171564a4d09276f576a07c4400 \
 | tar -xz --strip-components=1 -C /opt/cliscade-sdk \
 && cd /opt/cliscade-sdk \
 && uv sync --frozen --no-dev --package openhands-agent-server --python /usr/local/bin/python
ENV PATH="/opt/cliscade-sdk/.venv/bin:$PATH"
ENTRYPOINT ["tini", "--", "/opt/cliscade-sdk/.venv/bin/agent-server"]
COPY --from=login-cli /usr/local/lib/node_modules /usr/local/lib/node_modules
COPY --from=login-cli /usr/local/bin/kiro-cli* /usr/local/bin/
COPY --from=login-cli /usr/local/bin/agy_acp_server.par /usr/local/bin/localharness_external /usr/local/bin/
RUN ln -sf /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex \
 && ln -sf /usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe /usr/local/bin/claude \
 && ln -sf /usr/local/lib/node_modules/opencode-ai/bin/opencode.exe /usr/local/bin/opencode \
 && ln -sf /usr/local/lib/node_modules/@tencent-ai/codebuddy-code/bin/codebuddy /usr/local/bin/codebuddy
USER 1000:1000
